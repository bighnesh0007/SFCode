      "explanation": "0, empty string, null, undefined, NaN and false are falsy; '0' and [] are truthy."
    },
    {
      "id": "js-spread-copy",
      "section": "variables",
      "prompt": "Which creates a shallow copy of the array `a`?",
      "options": [
        {
          "id": "a",
          "text": "const b = a;"
        },
        {
          "id": "b",
          "text": "const b = [...a];"
        },
        {
          "id": "c",
          "text": "const b = a.push();"
        },
        {
          "id": "d",
          "text": "const b = &a;"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Spread copies elements into a new array; assignment just shares the reference."
    },
    {
      "id": "js-map-filter",
      "section": "variables",
      "prompt": "What does `[1, 2, 3, 4].filter(n => n % 2).map(n => n * 10)` return?",
