      "id": "js-let-const",
      "section": "variables",
      "prompt": "Which statement about `const` is true?",
      "options": [
        {
          "id": "a",
          "text": "The value can never change"
        },
        {
          "id": "b",
          "text": "The binding can't be reassigned, but an object it holds can still be mutated"
        },
        {
          "id": "c",
          "text": "It's function-scoped"
        },
        {
          "id": "d",
          "text": "It's hoisted and initialised to undefined"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "const prevents reassignment of the variable; the object itself stays mutable."
    },
