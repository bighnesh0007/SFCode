    {
      "id": "js-event-bubbling",
      "section": "browser",
      "prompt": "A click on a button inside a div with its own click listener runs which listeners by default?",
      "options": [
        {
          "id": "a",
          "text": "Only the button's"
        },
        {
          "id": "b",
          "text": "The button's, then the div's (bubbling)"
