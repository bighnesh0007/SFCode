    },
    {
      "id": "js-extends-super",
      "section": "objects",
      "prompt": "In a subclass constructor, what must happen before using `this`?",
      "options": [
        {
          "id": "a",
          "text": "Nothing"
        },
        {
          "id": "b",
          "text": "Call super(...)"
