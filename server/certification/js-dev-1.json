        },
        {
          "id": "d",
          "text": "\"number\""
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "A long-standing quirk: typeof null is 'object'."
    },
    {
      "id": "js-falsy",
      "section": "variables",
      "prompt": "Which values are falsy? Choose 3.",
      "options": [
        {
          "id": "a",
          "text": "0"
        },
        {
          "id": "b",
          "text": "\"\""
        },
        {
