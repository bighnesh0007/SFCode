  "questions": [
    {
      "id": "js-let-const",
      "section": "variables",
      "prompt": "Which statement about `const` is true?",
      "options": [
        {
          "id": "a",
          "text": "The value can never change"
        },
        {
          "id": "b",
          "text": "The binding can't be reassigned, but an object it holds can still be mutated"
        },
        {
          "id": "c",
          "text": "It's function-scoped"
        },
        {
          "id": "d",
          "text": "It's hoisted and initialised to undefined"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "const prevents reassignment of the variable; the object itself stays mutable."
    },
    {
      "id": "js-equality",
      "section": "variables",
      "prompt": "What does `0 == ''` evaluate to, and `0 === ''`?",
      "options": [
        {
          "id": "a",
          "text": "true, false"
        },
        {
          "id": "b",
          "text": "false, false"
        },
        {
          "id": "c",
          "text": "true, true"
        },
        {
          "id": "d",
          "text": "false, true"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "== coerces both to numbers (0 == 0), while === compares type and value without coercion."
    },
    {
      "id": "js-typeof-null",
      "section": "variables",
      "prompt": "What does `typeof null` return?",
