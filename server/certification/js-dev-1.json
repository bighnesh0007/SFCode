        {
          "id": "c",
          "text": "The div's, then the button's"
        },
        {
          "id": "d",
          "text": "Neither"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Events bubble from the target up through its ancestors."
    },
    {
      "id": "js-stop-propagation",
      "section": "browser",
      "prompt": "Which stops an event reaching parent listeners?",
      "options": [
        {
          "id": "a",
          "text": "event.preventDefault()"
        },
        {
          "id": "b",
          "text": "event.stopPropagation()"
        },
        {
          "id": "c",
          "text": "return false in addEventListener"
        },
        {
          "id": "d",
          "text": "event.cancel()"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "stopPropagation stops bubbling; preventDefault stops the default action (like following a link)."
    },
