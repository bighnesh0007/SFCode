    {
      "id": "js-this-arrow",
      "section": "objects",
      "prompt": "Inside an arrow function, what does `this` refer to?",
      "options": [
        {
          "id": "a",
          "text": "The arrow function itself"
        },
        {
          "id": "b",
          "text": "The `this` of the enclosing scope"
        },
        {
          "id": "c",
          "text": "Always the global object"
        },
        {
          "id": "d",
          "text": "The caller"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Arrow functions don't bind their own this; they use the surrounding one."
    },
    {
      "id": "js-class-static",
      "section": "objects",
      "prompt": "How do you call a static method `create` on class `Order`?",
      "options": [
        {
          "id": "a",
          "text": "new Order().create()"
        },
        {
          "id": "b",
          "text": "Order.create()"
        },
        {
          "id": "c",
          "text": "Order.prototype.create()"
        },
        {
          "id": "d",
          "text": "this.create()"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Static methods belong to the class itself, not instances."
    },
    {
      "id": "js-destructuring",
      "section": "objects",
      "prompt": "What is `b` after `const { a, b = 2 } = { a: 1 };`?",
      "options": [
        {
          "id": "a",
          "text": "undefined"
        },
        {
          "id": "b",
          "text": "2"
