        },
        {
          "id": "d",
          "text": "An error"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Destructuring defaults apply when the property is undefined."
    },
    {
      "id": "js-closure",
      "section": "objects",
      "prompt": "Given `function makeCounter() { let n = 0; return () => ++n; }` and `const next = makeCounter();`, what do two calls to `next()` return?",
      "options": [
        {
          "id": "a",
          "text": "1 then 1"
        },
        {
          "id": "b",
          "text": "1 then 2"
        },
        {
          "id": "c",
          "text": "0 then 1"
        },
        {
          "id": "d",
          "text": "undefined"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "The returned function closes over n, which persists between calls."
    },
    {
      "id": "js-prototype",
      "section": "objects",
      "prompt": "Where does `obj.toString()` come from on a plain object?",
      "options": [
        {
          "id": "a",
          "text": "The object itself"
        },
        {
          "id": "b",
          "text": "Object.prototype, via the prototype chain"
        },
        {
          "id": "c",
          "text": "The window object"
        },
        {
          "id": "d",
          "text": "A global function"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Property lookups walk the prototype chain up to Object.prototype."
    },
    {
      "id": "js-object-freeze",
      "section": "objects",
      "prompt": "After `const o = Object.freeze({ x: 1 }); o.x = 2;` in non-strict code, what is o.x?",
      "options": [
        {
          "id": "a",
          "text": "2"
        },
        {
          "id": "b",
          "text": "1"
        },
        {
          "id": "c",
          "text": "undefined"
        },
        {
          "id": "d",
          "text": "It throws"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": "Frozen objects can't be changed; the assignment is ignored (it throws only in strict mode)."
    },
    {
      "id": "js-getter",
      "section": "objects",
      "prompt": "Which defines a computed property `full` on a class?",
