        {
          "id": "a",
          "text": "[10, 30]"
        },
        {
          "id": "b",
          "text": "[20, 40]"
        },
        {
          "id": "c",
          "text": "[10, 20, 30, 40]"
        },
        {
          "id": "d",
          "text": "[1, 3]"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": "filter keeps odd numbers (1, 3), then map multiplies each by 10."
    },
    {
      "id": "js-number-string",
      "section": "variables",
      "prompt": "What is `'5' + 2` and `'5' - 2`?",
