# Copy to server/.env (gitignored). Every variable is optional: a missing group
# disables that capability and the server says so at startup.
NODE_ENV=development
API_PORT=4100
HOST=127.0.0.1

# Postgres (docker compose up -d → port 5433)
DATABASE_URL=postgres://sfcode:sfcode@127.0.0.1:5433/sfcode

# Clerk — same instance as client/.env.local
CLERK_SECRET_KEY=

# Salesforce External Client App (OAuth). Callback URL to register in Salesforce:
#   https://sf.bighnesh.space/backend/api/v1/salesforce/oauth/callback  (= APP_URL + path)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=62.0

# Secrets at rest. Generate each with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

APP_URL=https://sf.bighnesh.space
CORS_ALLOWED_ORIGINS=https://sf.bighnesh.space,http://localhost:8100
TRUST_PROXY=loopback
LOG_LEVEL=info
