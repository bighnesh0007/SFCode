{
  "name": "sfcode-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SFCode backend — Salesforce org connections, Apex execution, data access.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "sh -c \"set -a; [ -f .env ] && . ./.env; set +a; drizzle-kit migrate\"",
    "db:check": "drizzle-kit check",
    "verify:problems": "node --env-file-if-exists=.env --import tsx/esm scripts/verify-problems.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.1",
    "@lwc/compiler": "^9.5.3",
    "@lwc/engine-dom": "^9.5.3",
    "@lwc/rollup-plugin": "^9.5.3",
    "@lwc/synthetic-shadow": "^9.5.3",
    "@lwc/wire-service": "^9.5.3",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rollup": "^4.68.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.9"
  }
}
